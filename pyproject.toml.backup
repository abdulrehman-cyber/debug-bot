[project]
name = "chatbot"
version = "0.1.0"
description = "AI Debugging Chatbot for Pakistani Students"
readme = "README.md"
authors = [
    { name = "Abdul-Rehman-Projects", email = "meharabdul1463@gmail.com" }
]
requires-python = ">=3.8"
dependencies = [
    "google-generativeai>=0.3.0",
    "flask>=3.0.0",
    "flask-cors>=4.0.0",
    "python-dotenv>=1.0.0"
]

[project.scripts]
chatbot = "chatbot:main"

[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"